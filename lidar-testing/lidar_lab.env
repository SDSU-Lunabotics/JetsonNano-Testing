# Standalone Unitree L2 LiDAR map settings.
# Run with: ./lidar-testing/RunLidarLab.sh

# Input mode:
# - sdk  : direct Unitree SDK bridge process (no ROS2 required)
# - ros2 : ROS2 PointCloud2 topic
# - auto : try sdk first, then ros2 fallback
INPUT_MODE="sdk"

# SDK bridge command used in INPUT_MODE=sdk or auto.
# Default is already: python3 ./lidar-testing/unitree_sdk_bridge.py
# You can append module/class args if your SDK wrapper needs them:
# SDK_CMD="python3 ./lidar-testing/unitree_sdk_bridge.py --module unitree_lidar_sdk2 --class-name UnitreeLidar"
SDK_CMD=""
SDK_STARTUP_TIMEOUT_SEC=5.0

# ROS2 PointCloud2 topic from Unitree L2 driver.
# Common values:
# - /utlidar/cloud
# - /unitree_lidar/points
LIDAR_TOPIC="/utlidar/cloud"
QUEUE_SIZE=5
FRAME_STRIDE=1
POINT_STRIDE=2

# Axis mapping in incoming cloud frame.
# Unitree/ROS2 standard is usually x=forward, y=left, z=up.
UP_AXIS="z"
FORWARD_AXIS="x"
LATERAL_AXIS="y"

# Point filters (meters)
MIN_RANGE_M=0.20
MAX_RANGE_M=12.0
MIN_FORWARD_M=-1.0
MAX_FORWARD_M=12.0
MAX_ABS_LATERAL_M=10.0

# Ground / wall / hole thresholds (meters)
GROUND_THRESH_M=0.08
OBSTACLE_THRESH_M=0.08
HOLE_THRESH_M=0.10
MAX_ABOVE_GROUND_M=1.22
DISABLE_HOLES=0

# Ground-plane RANSAC fitting
PLANE_UPDATE_SEC=0.50
PLANE_RANSAC_ITERS=120
PLANE_MIN_NORMAL_UP=0.70
PLANE_FIT_MIN_RANGE_M=0.25
PLANE_FIT_MAX_RANGE_M=5.0
PLANE_FIT_MAX_ABS_UP_M=0.60

# 2D map settings
MAP_WIDTH_M=20.0
MAP_HEIGHT_M=20.0
MAP_RES_M=0.05
MAP_FORWARD_MIN=0.0
MAP_CENTER=1
MAP_SCALE=2

# Persistent map file
MAP_SAVE_PATH="./lidar-testing/lidar_map.npz"
MAP_SAVE_EVERY=5.0
MAP_LOAD=0

# Map decay
FREE_DECAY=0.995
OCC_DECAY=0.98
HOLE_DECAY=0.98

# Runtime
PRINT_EVERY_SEC=1.0
NO_GUI=0
