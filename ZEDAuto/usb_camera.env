# Default launch options for RunUsbCamera.sh.
# Run from the Jetson/VNC desktop:
#   ./ZEDAuto/RunUsbCamera.sh
#
# If launching over SSH into an existing TigerVNC session, set:
#   USB_CAMERA_DISPLAY=":2"

AUTO_START_VNC=0
VNC_DISPLAY=":2"
VNC_LOCALHOST_NO=1
VNC_XSTARTUP="$HOME/.vnc/xstartup"

AUTO_START_JETSON_API=1
JETSON_API_BIND_HOST="0.0.0.0"
JETSON_API_CHECK_HOST="127.0.0.1"
JETSON_API_PORT=8000

# Usually 0 for the first USB camera. If the ZED or another camera already owns
# index 0, try 1, 2, or a stable path such as /dev/v4l/by-id/<camera-name>.
USB_CAMERA_DEVICE="0"
USB_CAMERA_WIDTH=1280
USB_CAMERA_HEIGHT=720
USB_CAMERA_FPS=30
USB_CAMERA_FOURCC="MJPG"
USB_CAMERA_WINDOW_NAME="USB Camera"
USB_CAMERA_SOURCE="usb_camera"
USB_CAMERA_FLIP="none"
USB_CAMERA_FULLSCREEN=0
USB_CAMERA_OVERLAY=1

# Optional: publish this USB feed into the existing Jetson API /camera endpoints.
# Leave blank when the ZED stack is also publishing there; the API currently has
# one latest-frame slot, so two publishers will overwrite each other.
USB_CAMERA_HEARTBEAT_URL=""
USB_CAMERA_PUBLISH_URL=""
USB_CAMERA_PUBLISH_INTERVAL_MS=120
USB_CAMERA_PUBLISH_JPEG_QUALITY=75
