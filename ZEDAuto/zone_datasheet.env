# Standalone datasheet logger defaults (separate from RunAuto / drive pipeline)

# 1 = enabled, 0 = disabled (default)
ENABLE_ZONE_DATASHEET=0

TRACKING=1
OUT_CSV="./ZEDAuto/zone_datasheet.csv"
STRIDE=8
SAMPLE_EVERY_SEC=1.0

# Number of random cells logged each cycle per zone type.
OBSTACLE_SAMPLES=5
HOLE_SAMPLES=3
GROUND_SAMPLES=0

# Classification thresholds
OBSTACLE_THRESH_M=0.05
HOLE_THRESH_M=0.10
MAX_ABOVE_GROUND_M=1.22
MAX_FORWARD_M=6.0

# Floor plane updates
FLOOR_UPDATE_SEC=0.5
FLOOR_MIN_NORMAL_Y=0.5

# Cell indexing map settings
MAP_WIDTH_M=20.0
MAP_HEIGHT_M=20.0
MAP_RES_M=0.05
MAP_CENTER=1
MAP_Z_MIN=0.0

# Random sampling seed
RNG_SEED=42
