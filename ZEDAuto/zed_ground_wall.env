# Default launch options for zed_ground_wall.py
# Edit values here so you can launch with one command:
#   ros2_configs/zed/run_zed_ground_wall.sh
# .. 
# How to run (team notes):
# 1) Open terminal at repo root:
#    cd ~/jetsonano-test-F25/JetsonNano-Testing
# 2) Launch with defaults from this file:
#    ros2_configs/zed/run_zed_ground_wall.sh
# 3) Optional one-time override:
#    ros2_configs/zed/run_zed_ground_wall.sh --map-scale 4
#
# Value conventions:
# - 1 = enabled / true
# - 0 = disabled / false

# ---------------------------
# VNC Auto-Start (Optional)
# ---------------------------

# Start TigerVNC automatically when run_zed_ground_wall.sh is launched.
AUTO_START_VNC=0

# VNC display number to start/check (port = 5900 + display number).
# :2 means connect with VNC client to JETSON_IP:5902.
VNC_DISPLAY=":2"

# If 1, allow remote VNC clients to connect over network.
VNC_LOCALHOST_NO=1

# xstartup script used by TigerVNC (must be executable if set).
VNC_XSTARTUP="$HOME/.vnc/xstartup"

# ---------------------------
# Core Mapping / Localization
# ---------------------------

# Enable ZED positional tracking (required for world-fixed map while moving).
TRACKING=1

# Enable ZED area-memory relocalization so restarts can recover pose without
# returning to the exact original start spot.
AREA_MEMORY_ENABLE=1

# Area-memory file used for load/save (same file for continuous updates).
AREA_LOAD_PATH="./ZEDAuto/zed_area_memory.area"
AREA_SAVE_PATH="./ZEDAuto/zed_area_memory.area"

# Save area memory every N seconds while tracking is valid.
AREA_SAVE_EVERY=30.0

# Center the map around Z=0 so start position appears near the middle.
MAP_CENTER=1

# Keep rover centered in the map view (display only).
# Toggle live with keyboard key: c
MAP_FOLLOW_ROVER=1

# Display scale for the map window (visual only, does not change map accuracy).
MAP_SCALE=2

# ---------------------------
# Persistent Map (Crash Resume)
# ---------------------------

# Path of persisted occupancy map (.npz).
MAP_SAVE_PATH="./ZEDAuto/zed_map.npz"

# Auto-save period in seconds (0 disables periodic save).
MAP_SAVE_EVERY=5.0

# 1 = load persisted map at startup (resume after reboot/crash), 0 = start empty.
MAP_LOAD=1

# Base decay fallback for free-space cells.
# Used only when specific free decay values below are not set.
FREE_DECAY=1.0

# Decay for LIGHT GREEN tentative free cells (still being confirmed).
# Lower value = fade faster.
FREE_DECAY_UNCONFIRMED=0.995

# Decay for DARK GREEN confirmed free cells.
# Set to 1.0 to keep high-confidence safe zones persistent.
FREE_DECAY_CONFIRMED=1.0

# Number of free observations needed before a cell becomes DARK GREEN.
FREE_CONFIRM_HITS=8

# Free/obstacle confidence ratio needed to mark a cell DARK GREEN.
# Higher value = stricter confirmation.
FREE_CONFIRM_RATIO=1.2

# If new obstacle/hole appears in a previously free cell, multiply free confidence
# by this factor to downgrade it quickly (0.0..1.0).
FREE_DOWNGRADE_FACTOR=0.8

# Decay for RED obstacle cells.
# Lower values remove stale obstacles faster.
OCC_DECAY=0.98

# Decay for BLUE hole cells.
HOLE_DECAY=0.98

# Height above floor to classify as obstacle (meters).
OBSTACLE_THRESH_M=0.06

# Depth below floor to classify as hole (meters).
# Slightly above default so tiny floor noise stays green while true dips can show as holes.
HOLE_THRESH_M=0.08

# Ignore points above this floor-relative height (meters).
# Lowering this trims ceiling/high-object noise and cuts processing load.
MAX_ABOVE_GROUND_M=1.00

# 1 = disable hole detection entirely (testing mode).
# This prevents blue hole marking and removes hole influence on planning/evidence.
DISABLE_HOLES=0

# Path blocking threshold: obstacle evidence needed before a cell is treated as blocked.
# Raise this to ignore tiny red speckles; lower this to be more conservative.
PATH_AVOID_OCC_MIN=5.0

# Path blocking ratio: occupied/free confidence ratio required for blocked status.
PATH_AVOID_OCC_RATIO=1.8

# Extra safety margin: occupied must exceed free by this amount before blocking.
# Helps prevent brief red flicker from instantly blocking a mostly-free corridor.
PATH_AVOID_OCC_ADVANTAGE=3.0

# A* connectivity:
# - 4 = up/down/left/right only
# - 8 = includes diagonals (usually smoother/faster paths)
PATH_CONNECTIVITY=8

# Rover footprint width in meters used for obstacle inflation.
# Increase if the rover clips corners; decrease if path is too conservative.
ROVER_SIZE_M=0.30

# Radius (meters) around rover to clear blocked cells for path start.
# Useful for camera blind spot directly under/near rover.
START_CLEAR_RADIUS_M=0.35

# Retry planning this often even if start/goal didn't move.
# Helps recover when first path attempt fails due temporary map noise.
PATH_REPLAN_SEC=0.5

# Floor plane update interval (seconds). Higher = less SDK load + less plane jitter.
FLOOR_UPDATE_SEC=0.8

# Reject plane updates if normal.y is too small (likely not a floor plane).
FLOOR_MIN_NORMAL_Y=0.60

# Floor plane smoothing factor (0..1). Lower values are steadier.
PLANE_EMA_ALPHA=0.25

# Reject abrupt plane orientation jumps from one update to the next.
PLANE_MAX_TILT_DELTA_DEG=12.0

# Reject abrupt plane height-offset jumps.
PLANE_MAX_HEIGHT_JUMP_M=0.15

# Force-accept a new plane after this many consecutive jump rejections.
# Prevents mapping from getting stuck on a stale floor model.
PLANE_FORCE_ACCEPT_REJECTS=20

# Point-cloud downsample stride. Higher = less CPU and less noisy speckle.
SAMPLE_STRIDE=8

# Ignore very near-field points where stereo depth is typically unstable.
MIN_RANGE_Z_M=0.0

# Ignore very far points to reduce load and false labels.
# Set <=0 to disable this filter.
MAX_RANGE_Z_M=0.0

# ---------------------------
# Optional Heatmap (Testing)
# ---------------------------

# 1 = enable heatmap module, 0 = disable.
HEATMAP=0

# Heatmap mode:
# - "risk"     = high red where obstacle/hole evidence dominates
# - "obstacle" = obstacle evidence only
# - "hole"     = hole evidence only
# - "free"     = free-space confidence only (green)
# - "evidence" = total observation density (grayscale)
HEATMAP_MODE="risk"

# Overlay strength when HEATMAP_WINDOW=0 (0.0 to 1.0).
HEATMAP_ALPHA=0.35

# Minimum combined evidence before a heatmap cell is shown.
HEATMAP_MIN_EVIDENCE=1.0

# 1 = show heatmap in separate window, 0 = blend into map window.
HEATMAP_WINDOW=0

# ---------------------------
# Drive Output (RoboRIO)
# ---------------------------

# Enable command output to NetworkTables for autonomous/manual driving.
DRIVE=1

# RoboRIO IP address on your robot network.
ROBORIO_IP="10.0.9.2"

# Forward speed command for auto/manual drive (0.0 to 1.0).
DRIVE_SPEED=0.7

# How long Jetson/CommandReady stays true for each command pulse.
# 0.10 matches the proven pulse style used in other test scripts.
DRIVE_READY_PULSE_SEC=0.10

# 1 = print outgoing NT command values for drive debugging.
DRIVE_DEBUG=0

# 1 = print NetworkTables session health and robot-published Jetson keys.
NT_HEALTH_DEBUG=0

# Seconds between NT health debug prints.
NT_HEALTH_PERIOD_SEC=1.0

# Re-publish AutomationEnabled/Speed/TurnSpeed at this rate while driving.
NT_ENABLE_HEARTBEAT_SEC=0.10

# If CommandReady stays true longer than this, clear it and continue.
NT_COMMAND_ACK_TIMEOUT_SEC=0.30

# Robot-side scale keys while automation is enabled.
NT_FORWARD_SCALE=1.0
NT_TURN_SCALE=1.0

# Flip heading by 180 degrees if robot drives opposite arrow direction.
# Keep 1 if heading is reversed; set 0 if already correct.
DRIVE_HEADING_FLIP=1

# ---------------------------
# Optional Remote Streaming
# ---------------------------

# Target laptop/receiver IP for UDP video stream.
# Leave empty to disable streaming.
# STREAM_IP=""

# UDP port for stream receiver.
# STREAM_PORT=5600

# Which frame to stream:
# - "camera" = camera overlay only
# - "map"    = occupancy map only
# - "both"   = side-by-side camera + map
# STREAM_VIEW="both"

# Disable local OpenCV windows when running headless (SSH/VNC optional).
# NO_GUI=0
