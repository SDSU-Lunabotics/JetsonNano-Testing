# Default launch options for zed_ground_wall.py
# Edit values here so you can launch with one command:
#   ros2_configs/zed/run_zed_ground_wall.sh
# .. 
# How to run (team notes):
# 1) Open terminal at repo root:
#    cd ~/jetsonano-test-F25/JetsonNano-Testing
# 2) Launch with defaults from this file:
#    ros2_configs/zed/run_zed_ground_wall.sh
# 3) Optional one-time override:
#    ros2_configs/zed/run_zed_ground_wall.sh --map-scale 4
#
# Value conventions:
# - 1 = enabled / true
# - 0 = disabled / false

# ---------------------------
# VNC Auto-Start (Optional)
# ---------------------------

# Start TigerVNC automatically when run_zed_ground_wall.sh is launched.
AUTO_START_VNC=0

# VNC display number to start/check (port = 5900 + display number).
# :2 means connect with VNC client to JETSON_IP:5902.
VNC_DISPLAY=":2"

# If 1, allow remote VNC clients to connect over network.
VNC_LOCALHOST_NO=1

# xstartup script used by TigerVNC (must be executable if set).
VNC_XSTARTUP="$HOME/.vnc/xstartup"

# ---------------------------
# Core Mapping / Localization
# ---------------------------

# Mapping mode: 0 = simple (direct plane accept, origin-anchored coords).
#               1 = complex (EMA plane smoothing, tilt/jump rejection, tracking-gated integration).
# For outdoor runs and higher drive speeds, complex mode is more stable.
# Default to simple for easier bring-up/debugging on the current rover.
COMPLEX_MAPPING=0

# Enable ZED positional tracking (required for world-fixed map while moving).
TRACKING=1

# Enable ZED area-memory relocalization so restarts can recover pose without
# returning to the exact original start spot.
AREA_MEMORY_ENABLE=1

# Area-memory file used for load/save (same file for continuous updates).
AREA_LOAD_PATH="./ZEDAuto/zed_area_memory.area"
AREA_SAVE_PATH="./ZEDAuto/zed_area_memory.area"

# Save area memory every N seconds while tracking is valid.
AREA_SAVE_EVERY=30.0

# Reject sudden tracking jumps bigger than this before they can move the map.
# Tighter than before so bad relocalization does not drag the map across the beach.
TRACKING_MAX_POSE_JUMP_M=0.50

# Reject sudden heading flips before they can rotate the map/arrow incorrectly.
TRACKING_MAX_HEADING_JUMP_DEG=30.0

# Require several stable tracking frames after reconnect before trusting pose again.
TRACKING_RECOVER_STABLE_FRAMES=8

# Localize Scan rotates in place so area memory can relock.
# Toggle live with keyboard key: l or the Localize Scan button.
LOCALIZE_TURN_SPEED=0.25
LOCALIZE_SCAN_SEC=8.0
LOCALIZE_MAX_SEC=20.0

# Center the map around Z=0 so start position appears near the middle.
MAP_CENTER=1

# Keep rover centered in the map view (display only).
# Toggle live with keyboard key: c
MAP_FOLLOW_ROVER=1

# Display scale for the map window (visual only, does not change map accuracy).
MAP_SCALE=2

# ---------------------------
# Persistent Map (Crash Resume)
# ---------------------------

# Path of persisted occupancy map (.npz).
MAP_SAVE_PATH="./ZEDAuto/zed_map.npz"

# Auto-save period in seconds (0 disables periodic save).
MAP_SAVE_EVERY=5.0

# 1 = load persisted map at startup (resume after reboot/crash), 0 = start empty.
MAP_LOAD=1

# Lightweight pose/alignment recovery can get stale if the rover is moved
# between runs. Leave startup recovery load off by default so ZED can relock
# fresh instead of inheriting an old heading/pose.
RECOVERY_LOAD=0
RECOVERY_SAVE_EVERY=1.0
RECOVERY_NT_MIRROR=1

# Base decay fallback for free-space cells.
# Used only when specific free decay values below are not set.
FREE_DECAY=1.0

# Decay for LIGHT GREEN tentative free cells (still being confirmed).
# Lower value = fade faster.
FREE_DECAY_UNCONFIRMED=0.995

# Decay for DARK GREEN confirmed free cells.
# Set to 1.0 to keep high-confidence safe zones persistent.
FREE_DECAY_CONFIRMED=1.0

# Number of free observations needed before a cell becomes DARK GREEN.
FREE_CONFIRM_HITS=8

# Free/obstacle confidence ratio needed to mark a cell DARK GREEN.
# Higher value = stricter confirmation.
FREE_CONFIRM_RATIO=1.2

# If new obstacle/hole appears in a previously free cell, multiply free confidence
# by this factor to downgrade it quickly (0.0..1.0).
FREE_DOWNGRADE_FACTOR=0.8

# Decay for RED obstacle cells.
# Lower values remove stale obstacles faster.
OCC_DECAY=1.00

# Decay for BLUE hole cells.
HOLE_DECAY=1.00

# Height above floor to classify as obstacle (meters).
OBSTACLE_THRESH_M=0.06

# Depth below floor to classify as hole (meters).
# Slightly above default so tiny floor noise stays green while true dips can show as holes.
HOLE_THRESH_M=0.08

# Ignore points above this floor-relative height (meters).
# Lowering this trims ceiling/high-object noise and cuts processing load.
MAX_ABOVE_GROUND_M=1.00

# 1 = disable hole detection entirely (testing mode).
# This prevents blue hole marking and removes hole influence on planning/evidence.
DISABLE_HOLES=0

# Path blocking threshold: obstacle evidence needed before a cell is treated as blocked.
# Raise this to ignore tiny red speckles; lower this to be more conservative.
PATH_AVOID_OCC_MIN=5.0

# Path blocking ratio: occupied/free confidence ratio required for blocked status.
PATH_AVOID_OCC_RATIO=1.8

# Extra safety margin: occupied must exceed free by this amount before blocking.
# Helps prevent brief red flicker from instantly blocking a mostly-free corridor.
PATH_AVOID_OCC_ADVANTAGE=3.0

# A* connectivity:
# - 4 = up/down/left/right only
# - 8 = includes diagonals (usually smoother/faster paths)
PATH_CONNECTIVITY=8

# Rover footprint width in meters used for obstacle inflation.
# Increase if the rover clips corners; decrease if path is too conservative.
# Set to 2x for extra clearance.
ROVER_SIZE_M=0.60

# Camera mount:
# - front = old setup near the digger/front side
# - rear  = camera on the deposition/back side looking backward
# If the rear camera still looks forward, use CAMERA_MOUNT=custom,
# CAMERA_MOUNT_YAW_DEG=0, and CAMERA_FORWARD_OFFSET_M=-0.30.
CAMERA_MOUNT=rear

# Optional mount overrides. Leave blank to use the preset.
# For CAMERA_MOUNT=rear, blank forward offset defaults to -ROVER_SIZE_M/2.
CAMERA_MOUNT_YAW_DEG=""
CAMERA_FORWARD_OFFSET_M=""
CAMERA_RIGHT_OFFSET_M=""

# Camera servo view targets used by Jetson.
# These are logical view angles before optional inversion is applied.
# Set CAMERA_SERVO_INVERT=1 when RoboRIO servo angles are reversed relative
# to Jetson's logical map/deposit view commands.
CAMERA_SERVO_TRACK=1
CAMERA_SERVO_INVERT=0
CAMERA_MAP_ANGLE_DEG=180.0
CAMERA_DEPOSIT_ANGLE_DEG=0.0
CAMERA_SERVO_MAP_TOL_DEG=8.0

# Radius (meters) around rover to clear blocked cells for path start.
# Useful for camera blind spot directly under/near rover.
START_CLEAR_RADIUS_M=0.35

# Retry planning this often even if start/goal didn't move.
# Helps recover when first path attempt fails due temporary map noise.
PATH_REPLAN_SEC=0.5

# Floor plane update interval (seconds). Slightly faster so the floor model keeps up
# while the rover is moving quickly, but still light enough for the Nano.
FLOOR_UPDATE_SEC=0.5

# Reject plane updates if normal.y is too small (likely not a floor plane).
FLOOR_MIN_NORMAL_Y=0.68

# Floor plane smoothing factor (0..1). Lower values are steadier.
PLANE_EMA_ALPHA=0.20

# Reject abrupt plane orientation jumps from one update to the next.
PLANE_MAX_TILT_DELTA_DEG=8.0

# Reject abrupt plane height-offset jumps.
PLANE_MAX_HEIGHT_JUMP_M=0.08

# Force-accept a new plane after this many consecutive jump rejections.
# Prevents mapping from getting stuck on a stale floor model.
PLANE_FORCE_ACCEPT_REJECTS=12

# Point-cloud downsample stride. Higher = less CPU and less noisy speckle.
# Slightly higher for faster outdoor runs and better Nano headroom.
SAMPLE_STRIDE=10

# Ignore very near-field points where stereo depth is typically unstable.
MIN_RANGE_Z_M=0.20

# Ignore very far points to reduce load and false labels.
# Set <=0 to disable this filter.
MAX_RANGE_Z_M=5.0

# ---------------------------
# Optional Heatmap (Testing)
# ---------------------------

# 1 = enable heatmap module, 0 = disable.
HEATMAP=0

# Heatmap mode:
# - "risk"     = high red where obstacle/hole evidence dominates
# - "obstacle" = obstacle evidence only
# - "hole"     = hole evidence only
# - "free"     = free-space confidence only (green)
# - "evidence" = total observation density (grayscale)
HEATMAP_MODE="risk"

# Overlay strength when HEATMAP_WINDOW=0 (0.0 to 1.0).
HEATMAP_ALPHA=0.35

# Minimum combined evidence before a heatmap cell is shown.
HEATMAP_MIN_EVIDENCE=1.0

# 1 = show heatmap in separate window, 0 = blend into map window.
HEATMAP_WINDOW=0

# ---------------------------
# Drive Output (RoboRIO)
# ---------------------------

# Enable command output to NetworkTables for autonomous/manual driving.
DRIVE=1

# RoboRIO IP address on your robot network.
ROBORIO_IP="10.0.9.2"

# Forward speed command for auto/manual drive (0.0 to 1.0).
DRIVE_SPEED=0.7

# 1 = invert the actual drivetrain forward/turn commands sent to RoboRIO.
HARD_DRIVE_FLIP=0

# Max change rate for auto forward command. Lower = smoother but less aggressive.
DRIVE_FORWARD_SLEW_PER_SEC=1.4

# Reactive close-obstacle backup safety (camera frame).
# If enough obstacle points are inside this forward distance and lane width,
# Jetson commands a short pulse away from what the camera sees.
# With CAMERA_MOUNT=rear, that pulse drives forward instead of reversing.
BACKUP_CLOSE_DIST_M=0.55
BACKUP_LANE_HALF_WIDTH_M=0.50
BACKUP_MIN_OBSTACLE_POINTS=12
BACKUP_CRITICAL_DIST_M=0.30
BACKUP_CRITICAL_MIN_POINTS=5
BACKUP_SPEED=0.40
BACKUP_HOLD_SEC=0.50

# How long Jetson/CommandReady stays true for each command pulse.
# 0.10 matches the proven pulse style used in other test scripts.
DRIVE_READY_PULSE_SEC=0.10

# 1 = print outgoing NT command values for drive debugging.
DRIVE_DEBUG=0

# 1 = print NetworkTables session health and robot-published Jetson keys.
NT_HEALTH_DEBUG=0

# Seconds between NT health debug prints.
NT_HEALTH_PERIOD_SEC=1.0

# Re-publish AutomationEnabled/Speed/TurnSpeed at this rate while driving.
NT_ENABLE_HEARTBEAT_SEC=0.10

# If CommandReady stays true longer than this, clear it and continue.
NT_COMMAND_ACK_TIMEOUT_SEC=0.30

# Robot-side scale keys while automation is enabled.
NT_FORWARD_SCALE=1.0
NT_TURN_SCALE=1.0

# Main rover mode enables the main-rover control gate on the RoboRIO.
# ZEDAuto still sends the AutomationCommand Jetson/CommandReady pulse protocol.
# Default is ON; set to 0 only if you intentionally want the gate disabled.
MAIN_ROVER_MODE=1
MAIN_ROVER_DEBUG=0

# While the driver is actively moving the sticks, pause Jetson auto commands and
# lighten camera processing so controller response stays sharp.
DRIVER_PRIORITY_MODE=1
DRIVER_PRIORITY_THRESHOLD=0.08
DRIVER_PRIORITY_SAMPLE_STRIDE=14

# Flip heading by 180 degrees if robot drives opposite the yellow map arrow.
# Rear-camera preset already handles the 180 degree camera yaw, so default is 0.
DRIVE_HEADING_FLIP=0

# Flip only the yellow map arrow by 180 degrees without changing drive commands.
DISPLAY_HEADING_FLIP=0

# ---------------------------
# Optional Remote Streaming
# ---------------------------

# Start in keyboard manual drive mode for Mini Rover drive checks.
# Set to 0 for normal click-to-goal autonomy.
MANUAL_START=1

# Target laptop/receiver IP for UDP video stream.
# Leave empty to disable streaming.
# STREAM_IP=""

# Shared file used for UI-issued map click/waypoint commands.
MAP_COMMAND_FILE="./ZEDAuto/zed_map_command.json"

# Start jetson_api automatically when local camera/map HTTP callbacks are enabled.
AUTO_START_JETSON_API=1
JETSON_API_BIND_HOST="0.0.0.0"
JETSON_API_CHECK_HOST="127.0.0.1"
JETSON_API_PORT=8000
JETSON_API_LOG="./jetson_api/jetson_api.log"

# Camera ownership heartbeat back to jetson_api so the UI can report the ZED
# camera as active even when this process owns the device.
CAMERA_HEARTBEAT_URL="http://127.0.0.1:8000/camera/heartbeat"
CAMERA_HEARTBEAT_INTERVAL_MS=1000
CAMERA_HEARTBEAT_TIMEOUT_MS=250
CAMERA_HEARTBEAT_SOURCE="zed_ground_wall"

# Publish the rendered obstacle-overlay camera view into jetson_api so the UI
# camera panel can consume the same feed without opening the ZED a second time.
CAMERA_PUBLISH_URL="http://127.0.0.1:8000/camera/frame"
CAMERA_PUBLISH_INTERVAL_MS=66
CAMERA_PUBLISH_JPEG_QUALITY=65
CAMERA_PUBLISH_TIMEOUT_MS=250
CAMERA_PUBLISH_SOURCE="zed_ground_wall"

# Publish the rendered occupancy map into jetson_api for browser/UI display.
MAP_PUBLISH_URL="http://127.0.0.1:8000/map/frame"
MAP_PUBLISH_INTERVAL_MS=80
MAP_PUBLISH_JPEG_QUALITY=65
MAP_PUBLISH_TIMEOUT_MS=250
MAP_PUBLISH_SOURCE="zed_ground_wall"

# UDP port for stream receiver.
# STREAM_PORT=5600

# Which frame to stream:
# - "camera" = camera overlay only
# - "map"    = occupancy map only
# - "both"   = side-by-side camera + map
# STREAM_VIEW="both"

# Disable local OpenCV windows when running headless (SSH/VNC optional).
# NO_GUI=0

# 1 = show only red (obstacles) on camera overlay, hide green ground coloring.
OVERLAY_RED_ONLY=0

# ---------------------------
# ---------------------------
# Rock Detection (YOLO Model)
# ---------------------------
#
# HOW TO SWAP MODELS:
#   1. Get the new .pt file from your classmate (Google Drive, Slack, USB, etc.)
#   2. Copy it into ZEDAuto/models/:
#        cp ~/Downloads/new_model.pt ZEDAuto/models/new_model.pt
#      (or SCP it directly onto the Jetson)
#   3. Update ROCK_MODEL below to the new filename.
#   4. Restart RunAuto.sh — no code changes needed.
#
# WHEN TO CHANGE:
#   - A classmate finishes a new training run with better mAP50 (check
#     DataTraining/runs/<run_name>/results.csv — higher mAP50 = better).
#   - You add new classes (e.g. pole, berm_marker) and retrain.
#   - Detection is missing too many rocks → lower ROCK_CONF or retrain with more data.
#   - Too many false positives on flat ground → raise ROCK_CONF.
#
# CURRENT MODEL: obstacle_refine_v3.pt
#   - Trained on rocks + obstacles from arena test data.
#   - Classes it knows: see ROCK_CLASSES below.
#   - To disable detection entirely, set ROCK_MODEL=""
#
# NOTE: .pt files are NOT committed to git (too large).
#   Share via Google Drive or SCP to Jetson directly:
#     scp ZEDAuto/models/obstacle_refine_v3.pt jetson@<IP>:~/JetsonNano-Testing/ZEDAuto/models/
#
ROCK_MODEL="./ZEDAuto/models/obstacle_refine_v3.pt"

# Detection confidence threshold (0.0 - 1.0).
#   0.35 = balanced starting point.
#   Lower (e.g. 0.20) = catches more rocks but may flag false positives on ground.
#   Higher (e.g. 0.50) = fewer false positives but may miss smaller/far rocks.
ROCK_CONF=0.35

# Run detection every N frames (higher = faster main loop, less frequent updates).
#   5 = good default (~2-3 detections/sec at 15fps).
#   1 = every frame (most responsive but costs CPU/GPU time).
ROCK_EVERY=5

# Obstacle evidence stamped onto the map per detected rock.
#   Higher = A* treats the cell as more impassable (harder to route through).
#   6.0 is a strong stamp; lower if rocks are being over-avoided.
ROCK_STAMP=6.0

# Comma-separated class names from the model to treat as map obstacles.
#   Must match the class names the model was trained with (see DataTraining/classes.txt).
#   Add "pole" here if the model knows poles and you want them on the map too.
ROCK_CLASSES="rock,obstacle"

# Comma-separated class names to keep as named map landmarks.
# Add new model classes here when you want them to stay marked on the map.
# Example: "backpack,pole,berm_marker,rock"
LANDMARK_CLASSES="backpack,rock,obstacle"

# Save repeated static AI detections as landmarks on the map.
LANDMARK_MEMORY=1
LANDMARK_PATH="./ZEDAuto/zed_landmarks.json"
LANDMARK_ASSOC_M=0.45
LANDMARK_MIN_HITS=2
LANDMARK_SAVE_EVERY=5.0

# When tracking is lost, use a re-seen saved landmark plus IMU/NavX heading
# fallback to pull the rover's map pose back toward the landmark match.
LANDMARK_RELOCALIZE=1
LANDMARK_RELOCALIZE_MAX_OFFSET_M=4.0
LANDMARK_RELOCALIZE_ALPHA=0.65

# ---------------------------
# Human Detection (ZED SDK)
# ---------------------------

# 1 = enable ZED built-in object detection for person/human detection.
HUMAN_DETECT=1

# ZED OD confidence threshold (1-99).
HUMAN_OD_CONFIDENCE=40

# Run detection every N frames (1 = every frame).
HUMAN_OD_EVERY=1

 # Distance thresholds for human hazard state (HUMAN_STOP_M = 1.5 ft = 0.4572 m).
HUMAN_STOP_M=0.4572
HUMAN_SLOW_M=3.0

# Minimum confidence to trigger hazard state.
HUMAN_MIN_CONF=0.40

# ---------------------------
# Mining Automation
# ---------------------------

# Seconds of slow forward creep per dig strip (simulates bucket filling).
MINING_DIG_DURATION=5.0

# Forward motor value during dig creep (0-1, kept slow ~0.20).
MINING_DIG_SPEED=0.20

# Seconds to reverse backward after each dig strip.
MINING_BACKUP_DURATION=2.0

# Motor value during post-dig backup (0-1).
MINING_BACKUP_SPEED=0.35

# Seconds to reverse into the deposit zone (treadmill on back).
MINING_DEPOSIT_DURATION=5.0

# Motor value while reversing into deposit zone (0-1).
MINING_DEPOSIT_BACKUP_SPEED=0.35

# Fallback distance (m) from deposit center if the zone edge cannot be found.
MINING_DEPOSIT_APPROACH_DIST=1.0

# How far the rover's rear edge should sit inside the deposit boundary
# at the edge waypoint.
MINING_DEPOSIT_BOUNDARY_INSET_M=0.05

# Row spacing between dig strips in metres (0 = auto: rover_size_m * 0.8).
MINING_STRIP_PITCH=0.0

# Distance (m) at which the rover considers a waypoint "reached".
MINING_GOAL_TOL_M=0.4

# Path to persist zone definitions between runs (JSON).
# MINING_ZONES_PATH=./ZEDAuto/mining_zones.json
