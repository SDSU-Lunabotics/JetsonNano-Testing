# Perception Lab defaults (separate from ZEDAuto drive stack)

# Geometry base
TRACKING=1
FLOOR_UPDATE_SEC=0.5
FLOOR_MIN_NORMAL_Y=0.5
STRIDE=8
OBSTACLE_THRESH_M=0.05
HOLE_THRESH_M=0.10
MAX_ABOVE_GROUND_M=1.22
MAX_FORWARD_M=6.0
MIN_BOX_AREA_PX=1200
GROUND_BAND_M=0.10

# Optional AI detector (YOLO via ultralytics)
# Leave empty to run geometry-only mode.
AI_MODEL_PATH=""
AI_LABELS_PATH=""
AI_CONF=0.40
AI_IOU=0.45
AI_EVERY=2
AI_IMGSZ=640
AI_DEVICE=""

# Detector source:
# - "zed"  = ZED SDK built-in object detection (offline, no cloud/API key)
# - "yolo" = custom YOLO model
# - "both" = run both
# - "none" = geometry only
DETECTOR_MODE="zed"
ZED_OD_CONFIDENCE=40
ZED_OD_EVERY=1
ZED_OD_TRACKING=0

# Annotation + semantic map workflow
# Classes map to hotkeys 1..9 in order.
CLASSES="ground,wall,rock,person,hole,unknown_anomaly,cable,cone,other"

# Start with annotation mode on (drag/click then press 1..9).
ANNOTATION_MODE=1

# Where labeled images/YOLO labels/metadata are saved.
DATASET_DIR="./perception-testing/dataset"

# Build semantic top-down map from labeled boxes.
SEMANTIC_MAP=1
MAP_WIDTH_M=20.0
MAP_HEIGHT_M=20.0
MAP_RES_M=0.05
MAP_CENTER=1
SEMANTIC_POINT_STRIDE=4
SEMANTIC_DECAY=1.0

# Show ZEDAuto-style terrain occupancy map while people/object detection runs.
ZEDAUTO_MAP=1
ZEDAUTO_MAP_DECAY=0.97

# 1 = obstacle-only terrain map mode (no green ground fill).
OBSTACLES_ONLY=1

# Clear stale obstacles if not observed after roughly this many frames.
# Set ZEDAUTO_OCC_DECAY > 0 to override this auto behavior directly.
ZEDAUTO_CLEAR_PASSES=12
ZEDAUTO_OCC_DECAY=0

# ---------------------------
# Simple Terrain Viewer
# ---------------------------
# Used by: ./perception-testing/RunTerrainSimple.sh
TERRAIN_SHOW_HOLES=1
TERRAIN_MAP_SCALE=3
TERRAIN_MAP_DECAY=0.995
TERRAIN_FREE_DECAY=1.0
TERRAIN_OCC_DECAY=1.0
TERRAIN_HOLE_DECAY=1.0
